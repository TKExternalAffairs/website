---
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  imageClass?: string;
  middleText?: string;
  detailHref?: string;
  english?: string;
  number?: string;
}
const {
  imageSrc,
  imageAlt = "",
  imageClass = "",
  middleText = "",
  detailHref = "/groups/",
  english = "SPECIAL TEAM",
  number,
} = Astro.props;
---

<a class="voyage-group-card" href={detailHref}>
  <div class="voyage-group-card__image">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} class={imageClass} loading="lazy" />
    ) : (
      <div class="voyage-group-card__placeholder">
        <span>Voyage</span>
        <span>COMING SOON</span>
      </div>
    )}
    {number && <span class="voyage-group-card__number">{number}</span>}
  </div>
  <div class="voyage-group-card__body">
    <div>
      <span class="voyage-eyebrow">{english}</span>
      <h2>{middleText}</h2>
    </div>
    <span class="voyage-circle-arrow" aria-hidden="true">
      ↗
    </span>
  </div>
</a>
