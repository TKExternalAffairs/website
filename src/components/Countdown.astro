---
interface Props {
  targetISO: string;
}
const { targetISO } = Astro.props;
---

<div class="voyage-countdown" data-countdown data-target={targetISO}>
  <p>筑駒文化祭まであと</p>
  <p class="voyage-countdown__digits" aria-label="開催までの残り時間">
    <span data-days>--</span>
    <small>日</small>
    <span data-clock>--:--:--</span>
  </p>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((root) => {
    const target = Date.parse(root.dataset.target ?? "");
    if (!Number.isFinite(target)) return;
    const pad = (n: number) => String(n).padStart(2, "0");
    let timer: ReturnType<typeof setInterval>;
    const render = () => {
      const seconds = Math.max(0, Math.floor((target - Date.now()) / 1000));
      root.querySelector("[data-days]")!.textContent = pad(
        Math.floor(seconds / 86400),
      );
      root.querySelector("[data-clock]")!.textContent = [
        Math.floor(seconds / 3600) % 24,
        Math.floor(seconds / 60) % 60,
        seconds % 60,
      ]
        .map(pad)
        .join(":");
      if (!seconds) clearInterval(timer);
    };
    const start = () => {
      clearInterval(timer);
      render();
      if (Date.now() < target) timer = setInterval(render, 1000);
    };
    start();
    window.addEventListener("pagehide", () => clearInterval(timer));
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) start();
    });
  });
</script>
