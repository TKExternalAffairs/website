---
import SocialIcon from "./SocialIcon.astro";
import type { SocialLink } from "../lib/socialLinks";

interface Props {
  title: string;
  description?: string;
  links: SocialLink[];
  compact?: boolean;
}

const { title, description, links, compact = false } = Astro.props;
---

<section
  class:list={["social-links", { "social-links--compact": compact }]}
  aria-label={title}
>
  <h2 class="font-hakushu social-links__title">{title}</h2>
  {description && <p class="social-links__description">{description}</p>}
  <p class="social-links__notice">各リンクは新しいタブで開きます。</p>
  <ul class="social-links__list" role="list">
    {links.map(({ platform, label, href, detail }) => (
      <li>
        <a href={href} target="_blank" rel="noopener noreferrer">
          <span class="social-links__icon">
            <SocialIcon platform={platform} />
          </span>
          <span class="social-links__text">
            <span class="social-links__label">{label}</span>
            {detail && <span class="social-links__detail">{detail}</span>}
          </span>
          <svg
            class="social-links__external"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M14 4h6v6M20 4 10 14M10 4H4v16h16v-6" />
          </svg>
          <span class="sr-only">（新しいタブで開きます）</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .social-links {
    width: 80%;
    max-width: 72rem;
    margin: 3rem auto;
  }

  .social-links__title {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .social-links__title::before {
    content: "";
    width: 0.25em;
    height: 1.1em;
    flex-shrink: 0;
    background: currentColor;
  }

  .social-links__description {
    margin: 0.75rem 0 0;
    color: #e5e7eb;
    line-height: 1.8;
  }

  .social-links__notice {
    margin: 0.5rem 0 0;
    color: #9ca3af;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .social-links__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .social-links__list li {
    min-width: 0;
  }

  .social-links__list a {
    display: flex;
    height: 100%;
    min-height: 5rem;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem;
    border: 1px solid #4b5563;
    background: rgb(255 255 255 / 3%);
    color: inherit;
    text-decoration: none;
  }

  .social-links__list a:hover {
    border-color: #e5e7eb;
    background: rgb(255 255 255 / 8%);
  }

  .social-links__list a:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
  }

  .social-links__icon,
  .social-links__external {
    flex-shrink: 0;
  }

  .social-links__text {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    overflow-wrap: anywhere;
  }

  .social-links__label {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .social-links__detail {
    color: #d1d5db;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .social-links__external {
    color: #9ca3af;
  }

  .social-links--compact {
    width: 100%;
    margin: 0;
  }

  .social-links--compact .social-links__title {
    justify-content: center;
    font-size: 1.25rem;
  }

  .social-links--compact .social-links__title::before {
    display: none;
  }

  .social-links--compact .social-links__description,
  .social-links--compact .social-links__notice {
    text-align: center;
  }

  .social-links--compact .social-links__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 768px) {
    .social-links {
      width: 90%;
      margin: 2rem auto;
    }

    .social-links--compact {
      width: 100%;
      margin: 0;
    }

    .social-links--compact .social-links__list {
      grid-template-columns: 1fr;
    }
  }
</style>
