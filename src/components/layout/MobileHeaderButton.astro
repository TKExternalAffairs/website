---
import { Image } from "astro:assets";

interface Props {
  id: string;
  imageSrc: ImageMetadata;
  closeImageSrc: ImageMetadata;
  ariaControls: string;
  ariaExpanded: "true" | "false";
  ariaLabel: string;
}

const { id, imageSrc, closeImageSrc, ariaControls, ariaExpanded, ariaLabel } =
  Astro.props;
---

<button
  type="button"
  class="menu-toggle relative flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-lg transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
  id={id}
  aria-expanded={ariaExpanded}
  aria-controls={ariaControls}
  aria-label={ariaLabel}
>
  <Image
    src={imageSrc}
    width={40}
    height={40}
    alt=""
    aria-hidden="true"
    class="menu-icon menu-icon-open absolute"
    loading="eager"
  />
  <Image
    src={closeImageSrc}
    width={32}
    height={32}
    alt=""
    aria-hidden="true"
    class="menu-icon menu-icon-close absolute"
    loading="eager"
  />
</button>

<style>
  .menu-icon {
    transition:
      opacity 160ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-icon-close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.85);
  }
  [aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(45deg) scale(0.85);
  }
  [aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-icon {
      transition: none;
    }
  }
</style>
