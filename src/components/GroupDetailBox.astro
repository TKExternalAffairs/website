---
interface Props {
  title: string;
  imageSrc: string;
  imageAlt?: string;
  paragraphs: string[];
}
const { title, imageSrc, imageAlt = "", paragraphs } = Astro.props;
---

<section class="group-detail-box">
  <h2 class="group-detail-box__title">{title}</h2>
  <div class="group-detail-box__image-area">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="group-detail-box__image"
      loading="lazy"
    />
  </div>
  <div class="group-detail-box__text-area">
    {paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</section>
