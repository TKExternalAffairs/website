---
import Layout from "../../layouts/Layout.astro";
import GroupDetailBox from "../../components/GroupDetailBox.astro";
import Title from "../../components/layout/Title.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import SocialFeedSection from "../../components/SocialFeedSection.astro";
import { groupSocialFeeds } from "../../lib/socialFeeds";
import { groupSocialLinks } from "../../lib/socialLinks";
import coffeeImage from "../../assets/Webp/groups/kissa/kissa_1.webp";
import foodImage from "../../assets/Webp/groups/kissa/kissa_2.webp";
import titleImage from "../../assets/Webp/groups/kissa/kissa_Title.webp";
---

<Layout title="喫茶班" description="高三特別班 喫茶班の紹介ページです。">
  <Title heroImage={titleImage.src} title="喫茶班" />
  <SocialLinks title="喫茶班の公式SNS" links={groupSocialLinks.kissa} />

  <GroupDetailBox
    title="喫茶班とは"
    imageSrc={titleImage.src}
    imageAlt="喫茶班の会場"
    paragraphs={[
      "喫茶班は、正門入って右にある50周年記念会館にてドリンクや軽食の販売を行います。",
      "味は勿論のこと、接客の所作や雰囲気作りにも力を入れて皆様のことをお待ちしております。",
      "文化祭巡りに疲れた時には、喫茶でほっとできるひとときをどうぞ。",
    ]}
  />

  <GroupDetailBox
    title="こだわりのコーヒー"
    imageSrc={coffeeImage.src}
    imageAlt="喫茶班が提供するコーヒー"
    paragraphs={[
      "喫茶班が特に力を入れているものの一つが、コーヒーです。",
      "茨城県を中心に展開するサザコーヒー様の協力のもと豆のブレンドを行い、こだわりの一杯を提供します。",
      "班員が一杯一杯丁寧にドリップした最高の一杯を、ぜひご賞味あれ。",
    ]}
  />

  <GroupDetailBox
    title="軽食"
    imageSrc={foodImage.src}
    imageAlt="喫茶班が提供する軽食"
    paragraphs={[
      "喫茶班の軽食は、本当に美味しいと思ったものしか提供していません。",
      "試作を重ね、どの素材・どの工程にすればより美味しくなるのか日夜研究した成果が一品一品に詰まっています。",
      "試行錯誤の末出来上がった、努力の結晶をご提供します。",
    ]}
  />
  <section class="special-thanks" aria-labelledby="special-thanks-title">
    <h2 id="special-thanks-title" class="font-hakushu text-3xl sm:text-4xl">
      Special Thanks
    </h2>
    <h3 class="special-thanks__school text-2xl font-bold sm:text-3xl">
      東京栄養食糧専門学校様
    </h3>
    <p>
      私たち喫茶班は皆様に安心してお召し上がりいただけるよう、衛生管理を徹底しております。
      食材の取り扱いから全ての調理工程、提供に至るまで細心の注意を払い、調理器具や調理環境の清潔状態の維持にも努めております。
    </p>
    <p>
      しかし、私たち生徒だけでは知識も経験も不足しているため、より安全で質の高い食事を提供するために、専門家の方々から学ぶ必要があると考えました。
    </p>
    <p>
      そこで、今年は東京栄養食糧専門学校様にご依頼をし、各メニューの調理計画書を添削していただくだけでなく、実際に試作会にお呼びして下処理から提供までの全ての工程を確認していただき、専門的な視点から多くの貴重な助言をいただきました。
    </p>
    <p>
      ご多忙の中、私たちの活動にご協力いただきました東京栄養食糧専門学校の皆様に、心より感謝申し上げます。
    </p>
  </section>
  <SocialFeedSection accounts={groupSocialFeeds.kissa} />
</Layout>

<style>
  .special-thanks {
    width: 80%;
    margin: 3rem auto;
  }

  .special-thanks h2 {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .special-thanks h2::before {
    content: "";
    width: 0.4em;
    height: 1.1em;
    background-color: currentColor;
    flex-shrink: 0;
  }

  .special-thanks__school {
    margin: 1.5rem 0;
    overflow-wrap: anywhere;
  }

  .special-thanks p {
    margin: 0;
    line-height: 1.8;
  }

  .special-thanks p + p {
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .special-thanks {
      width: 90%;
      margin: 2rem auto;
    }

    .special-thanks h2 {
      font-size: 1.5rem;
    }
  }
</style>
