---
import Layout from "../../layouts/Layout.astro";
import Title from "../../components/layout/Title.astro";
import GroupIntroBox from "../../components/GroupIntroBox.astro";
import { groups } from "../../data/groups";
---

<Layout title="各班紹介" description="高三特別班の各班を紹介します。">
  <Title title="各班紹介" />
  <section class="voyage-container voyage-section">
    <div class="voyage-section-heading">
      <p class="voyage-eyebrow">MEET THE TEAMS</p>
      <h2>それぞれの、熱量。</h2>
      <p>高三特別班の企画・活動をご紹介します。</p>
    </div>
    <div class="voyage-group-grid">
      {groups.map((group, i) => (
        <GroupIntroBox
          imageSrc={group.image}
          imageAlt={`${group.title}のイメージ画像`}
          middleText={group.title}
          english={group.english}
          number={`0${i + 1}`}
          detailHref={`/groups/${group.id}/`}
          imageClass={group.id === "shogai" ? "voyage-group-card__office" : ""}
        />
      ))}
    </div>
  </section>
</Layout>
