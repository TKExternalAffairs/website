---
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown.astro";
import GroupIntroBox from "../components/GroupIntroBox.astro";
import { groups, visitorLinks } from "../data/groups";
import { getCollection } from "astro:content";
import { isVisibleInCurrentSite } from "../lib/site";
const news = (await getCollection("news"))
  .filter((item) => isVisibleInCurrentSite(item.data.publishTargets))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="トップ"
  description="第75回筑駒文化祭 高三特別班の公式サイト。各班の紹介、メニュー、縁日班の混雑状況をご案内します。"
>
  <section class="voyage-hero">
    <img
      class="voyage-hero__wordmark"
      src="/images/voyage/voyage-wordmark.svg"
      alt="2026年度 第75回筑駒文化祭 Voyage"
      width="430"
      height="190"
      fetchpriority="high"
    />
    <img
      class="voyage-hero__ship"
      src="/images/voyage/voyage-ship.svg"
      alt="波を越えて航海する青い帆船"
      width="478"
      height="405"
      fetchpriority="high"
    />
    <div class="voyage-hero__title">
      <p>THE 12TH GRADE SPECIAL TEAMS</p>
      <h1>高三特別班</h1>
      <span>高校生活最後の文化祭。その熱量の証明を。</span>
    </div>
    <a class="voyage-hero__scroll" href="#concept">
      SCROLL <span aria-hidden="true">↓</span>
    </a>
  </section>
  <section class="voyage-concept" id="concept">
    <div class="voyage-concept__inner">
      <div class="voyage-concept__lead">
        <Countdown targetISO="2026-10-30T09:00:00+09:00" />
        <p class="voyage-eyebrow">OUR LAST SCHOOL FESTIVAL</p>
        <h2>
          余白に記す、
          <br />
          熱量の証明。
        </h2>
        <p class="voyage-concept__caption">
          第七十五回筑駒文化祭
          <br />
          高三特別班
        </p>
      </div>
      <div class="voyage-concept__text">
        <p>
          高三特別班は本校文化祭における中核をなす組織の一つとして、
          <br />
          先輩方が守り、受け継いできた筑駒の一つの伝統です。
        </p>
        <p>
          高校生活最後の文化祭。
          <br />
          仲間とともに歩み、時に悩み、我々の出した答えが
          <br />
          今年度の高三特別班の企画そのものであり、
          <br />
          ご来場してくださる皆様への感謝と、我々の未来への誓いを込めた
          <br />
          最初で最高の最高傑作です。
        </p>
        <p>
          それでは、我々の熱量の証明をご覧ください。
          <br />
          ご来場お待ちしております。
        </p>
      </div>
    </div>
    <div class="voyage-visit voyage-container" id="visit">
      <div class="voyage-section-heading voyage-section-heading--light">
        <p class="voyage-eyebrow">PLAN YOUR VISIT</p>
        <h2>文化祭を、もっと楽しむ。</h2>
        <p>混雑度とメニューのご案内</p>
      </div>
      <div class="voyage-visit__grid">
        {visitorLinks.map((link, i) => (
          <a class="voyage-visit-card" href={link.href}>
            <span class="voyage-eyebrow">
              0{i + 1} / {link.english}
            </span>
            <h3>{link.title}</h3>
            <p>{link.description}</p>
            <span class="voyage-visit-card__bottom">
              詳しく見る <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div class="voyage-wave" aria-hidden="true">
    <img
      src="/images/voyage/voyage-wave.webp"
      alt=""
      width="1800"
      height="615"
    />
  </div>
  <section class="voyage-container voyage-section" id="groups">
    <div class="voyage-section-heading">
      <p class="voyage-eyebrow">SPECIAL TEAMS</p>
      <h2>各班紹介</h2>
      <p>それぞれの熱意が、この文化祭をつくる。</p>
    </div>
    <div class="voyage-group-grid">
      {groups.slice(0, 3).map((group, i) => (
        <GroupIntroBox
          imageSrc={group.image}
          imageAlt={`${group.title}のイメージ画像`}
          middleText={group.title}
          english={group.english}
          number={`0${i + 1}`}
          detailHref={`/groups/${group.id}/`}
        />
      ))}
    </div>
    <div class="voyage-center">
      <a class="voyage-outline-link" href="/groups/">
        各班紹介をすべて見る <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="voyage-container voyage-section voyage-news">
    <div class="voyage-section-heading">
      <p class="voyage-eyebrow">NEWS</p>
      <h2>お知らせ</h2>
    </div>
    <div class="voyage-news__list">
      {news.length ? (
        news.map((item) => (
          <a href={`/news/${item.id}/`}>
            <time datetime={item.data.pubDate.toISOString()}>
              {item.data.pubDate.toLocaleDateString("ja-JP", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
                timeZone: "Asia/Tokyo",
              })}
            </time>
            <span>{item.data.title}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      ) : (
        <p>現在、お知らせはありません。</p>
      )}
    </div>
    <div class="voyage-center">
      <a class="voyage-text-link" href="/news/">
        お知らせ一覧 →
      </a>
    </div>
  </section>
  <section class="voyage-container voyage-section voyage-sponsor-banner">
    <div>
      <p class="voyage-eyebrow">WITH OUR PARTNERS</p>
      <h2>ご協賛について</h2>
      <p>筑駒文化祭を支えてくださる皆様へ。</p>
    </div>
    <a class="voyage-outline-link" href="/kyousan/onegai/">
      協賛企業・ご協賛のお願い <span aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
